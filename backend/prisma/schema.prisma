datasource db {
  provider = "sqlite"
  url      = "file:./database.db"
}

generator client {
  provider = "prisma-client-py"
}

model LLMSettings {
  id          String   @id @default(cuid())
  ip          String
  port        Int
  modelName   String
  temperature Float
  maxTokens   Int
}

model BackendSettings {
  id          String   @id @default(cuid())
  apiUrl      String
  dbPath      String
}

model ComfyUISettings {
  id          String   @id @default(cuid())
  ip          String
  port        Int
  deviceId    String
  pollInterval Int     @default(4000)
}

model Project {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("single")
  duration      Int      @default(120)
  episodeCount  Int      @default(1)
  story         Story?
  script        Script?
  beats         Beat[]
  assets        Asset[]
  finalVideo    FinalVideo?
  shotList      ShotList[]
  audioAssets   AudioAsset[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Story {
  id           String   @id @default(cuid())
  projectId    String   @unique 
  project      Project  @relation(fields: [projectId], references: [id])
  narrativeArc String
  rawInput     String?
}

model Beat {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  storyId     String?
  order       Int
  content     String
  shots       Shot[]
  assets      Asset[]
}

model Asset {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id])
  beatId          String?
  beat            Beat?         @relation(fields: [beatId], references: [id])
  type            String   // "CHARACTER", "LOCATION", "PROP"
  name            String
  description     String?
  imagePath       String?
  prompt          String?
  states          AssetState[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model AssetState {
  id              String   @id @default(cuid())
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id])
  name            String
  description     String?
  prompt          String?
  imagePath       String?
  characterSheet  String?
  scenes          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Shot {
  id             String   @id @default(cuid())
  beatId         String
  beat           Beat     @relation(fields: [beatId], references: [id])
  order          Int
  prompt         String
  cameraMovement String?
  duration       Float?
  videoPath      String?
}

model AppActionMapping {
  id           String   @id @default(cuid())
  action       String   @unique
  promptFile   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Script {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id])
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FinalVideo {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id])
  totalDuration Float?
  exportPath   String?
  thumbnailUrl String?
}

model AudioAsset {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  audioPath   String
  audioType   String   // "VOICE_SAMPLE", "CHARACTER_DIALOG", "SCENE_DIALOG"
  transcript  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShotList {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  shot        Int
  scene       Int      @default(0)
  beats       String   @default("[]")
  loc         String   @default("")
  subs        String   @default("")
  frames      Int
  duration    Float
  camera      String
  action      String
  dialogue    String
  note        String
  prompt                String   @default("")
  locationAssetId       String?
  locationStateId       String?
  characterAssetIds     String?
  characterStateIds     String?
  propAssetIds          String?
  propStateIds          String?
  sceneDialogAudioId    String?
  characterAudioIds     String?
  characterAudioTypes   String?
  musicOn               Boolean  @default(false)
  musicDesc             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
